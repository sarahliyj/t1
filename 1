<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Stopwatch</title>
<style>
  html, body {
    margin: 0;
    padding: 0;
    background: #000;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }
  * { box-sizing: border-box; }

  .screen {
    width: 100vw;
    height: 100dvh;
    background: #000;
    color: #fff;
    position: relative;
    font-family: -apple-system, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    overflow: hidden;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
  }

  /* status bar */
  .statusbar {
    position: absolute;
    top: 16px;
    left: 24px;
    right: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .statusbar .time { font-size: 18px; font-weight: 600; letter-spacing: -0.2px; }
  .icons { display: flex; align-items: center; gap: 6px; }
  .signal { display: flex; align-items: flex-end; gap: 2px; height: 13px; }
  .signal span { width: 3.5px; background: #fff; border-radius: 1px; }
  .signal span:nth-child(1) { height: 5px; }
  .signal span:nth-child(2) { height: 7px; }
  .signal span:nth-child(3) { height: 9.5px; }
  .signal span:nth-child(4) { height: 13px; opacity: 0.35; }
  .battery { display: flex; align-items: center; gap: 2px; }
  .battery .pct { font-size: 13px; font-weight: 600; letter-spacing: 0.2px; }
  .battery .shell {
    width: 28px; height: 14px; border: 1px solid rgba(255,255,255,0.5);
    border-radius: 3.5px; padding: 1.5px; position: relative;
  }
  .battery .shell::after {
    content: ""; position: absolute; right: -3px; top: 4px;
    width: 2px; height: 5px; background: rgba(255,255,255,0.5); border-radius: 0 1px 1px 0;
  }
  .battery .fill { background: #fff; height: 100%; width: 42%; border-radius: 1.5px; }

  /* timer */
  .timer {
    position: absolute;
    top: 21.5%;
    left: 0; right: 0;
    text-align: center;
    font-size: 21vw;
    font-weight: 200;
    letter-spacing: -1px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* controls */
  .controls {
    position: absolute;
    top: 47.4%;
    left: 24px; right: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .btn {
    width: 78px; height: 78px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 17px; background: rgba(255,255,255,0.14); color: #fff;
    border: none; font-family: inherit;
  }
  .btn.start { background: rgba(48,209,88,0.16); color: #30d158; }
  .dots { display: flex; gap: 6px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #48484a; }
  .dot.active { background: #fff; }

  /* lap list */
  .laplist { position: absolute; top: 56.6%; left: 0; right: 0; border-top: 0.5px solid #38383a; }
  .laprow {
    display: flex; justify-content: space-between; padding: 14px 24px;
    border-bottom: 0.5px solid #38383a; font-size: 17px; font-variant-numeric: tabular-nums;
  }

  /* bottom tab bar */
  .tabbar { position: absolute; bottom: 16px; left: 0; right: 0; display: flex; justify-content: space-around; padding: 0 10px; }
  .tab { display: flex; flex-direction: column; align-items: center; gap: 4px; color: #8e8e93; font-size: 24px; }
  .tab.active { color: #ff9f0a; }
  .tab .label { font-size: 10px; letter-spacing: 0.1px; }

  /* settings gear */
  .gear-btn {
    position: absolute;
    top: 44px;
    right: 16px;
    width: 34px; height: 34px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    border: none;
    color: #fff;
    font-size: 16px;
    display: flex; align-items: center; justify-content: center;
    z-index: 20;
  }

  /* settings panel */
  .panel-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 30;
    display: none;
    align-items: flex-end;
  }
  .panel-backdrop.open { display: flex; }
  .panel {
    width: 100%;
    background: #1c1c1e;
    border-radius: 20px 20px 0 0;
    padding: 20px 20px calc(24px + env(safe-area-inset-bottom));
    color: #fff;
    font-family: -apple-system, "SF Pro Display", Arial, sans-serif;
  }
  .panel h3 { margin: 0 0 14px; font-size: 17px; font-weight: 600; }
  .row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .row label { font-size: 14px; color: #aeaeb2; }
  .row .inputs { display: flex; gap: 6px; align-items: center; }
  .row input[type="number"] {
    width: 52px; padding: 8px 6px; border-radius: 8px; border: none;
    background: #2c2c2e; color: #fff; font-size: 15px; text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .row .sep { color: #8e8e93; }
  .row-wide { margin-bottom: 12px; }
  .row-wide label { display: block; font-size: 14px; color: #aeaeb2; margin-bottom: 6px; }
  .row-wide input[type="number"] {
    width: 100%; padding: 10px; border-radius: 8px; border: none;
    background: #2c2c2e; color: #fff; font-size: 15px;
  }
  .toggle-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .apply-btn {
    width: 100%; padding: 13px; border-radius: 12px; border: none;
    background: #ff9f0a; color: #000; font-size: 16px; font-weight: 600;
    margin-top: 8px; font-family: inherit;
  }
  .close-btn {
    width: 100%; padding: 12px; border-radius: 12px; border: none;
    background: #2c2c2e; color: #fff; font-size: 15px;
    margin-top: 8px; font-family: inherit;
  }
  input[type="checkbox"] { width: 20px; height: 20px; }
</style>
</head>
<body>
<div class="screen">

  <div class="statusbar">
    <span class="time">4:21</span>
    <div class="icons">
      <div class="signal"><span></span><span></span><span></span><span></span></div>
      <svg width="19" height="14" viewBox="0 0 17 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8.5 10.2C9.2 10.2 9.8 10.7 9.8 11.4C9.8 12.1 9.2 12.6 8.5 12.6C7.8 12.6 7.2 12.1 7.2 11.4C7.2 10.7 7.8 10.2 8.5 10.2Z" fill="white"/>
        <path d="M8.5 6.8C10.1 6.8 11.6 7.4 12.7 8.4L11.3 9.9C10.5 9.2 9.5 8.8 8.5 8.8C7.5 8.8 6.5 9.2 5.7 9.9L4.3 8.4C5.4 7.4 6.9 6.8 8.5 6.8Z" fill="white"/>
        <path d="M8.5 3.4C11.1 3.4 13.4 4.4 15.2 6L13.8 7.5C12.4 6.3 10.5 5.5 8.5 5.5C6.5 5.5 4.6 6.3 3.2 7.5L1.8 6C3.6 4.4 5.9 3.4 8.5 3.4Z" fill="white"/>
      </svg>
      <div class="battery">
        <span class="pct">42</span>
        <div class="shell"><div class="fill"></div></div>
      </div>
    </div>
  </div>

  <div class="timer" id="timer">3:50:00.00</div>

  <div class="controls">
    <button class="btn" id="resetBtn">Reset</button>
    <div class="dots">
      <div class="dot active"></div>
      <div class="dot"></div>
    </div>
    <button class="btn start" id="startbtn">Stop</button>
  </div>

  <div class="laplist">
    <div class="laprow">
      <span>Lap 1</span>
      <span id="lap">3:50:00.00</span>
    </div>
  </div>

  <div class="tabbar">
    <div class="tab"><span>🌐</span><span class="label">World Clock</span></div>
    <div class="tab"><span>⏰</span><span class="label">Alarms</span></div>
    <div class="tab active"><span>⏱️</span><span class="label">Stopwatch</span></div>
    <div class="tab"><span>⏲️</span><span class="label">Timers</span></div>
  </div>

  <!-- Settings panel -->
  <div class="panel-backdrop" id="panelBackdrop">
    <div class="panel">
      <h3>起始时间 / 倍速设置</h3>

      <div class="row">
        <label>起始时间</label>
        <div class="inputs">
          <input type="number" id="startH" min="0" max="9" value="3">
          <span class="sep">:</span>
          <input type="number" id="startM" min="0" max="59" value="50">
          <span class="sep">:</span>
          <input type="number" id="startS" min="0" max="59" value="0">
        </div>
      </div>

      <div class="row-wide">
        <label>倍速 (x)</label>
        <input type="number" id="speedInput" min="0.5" max="20" step="0.5" value="3">
      </div>

      <div class="toggle-row">
        <label style="font-size:14px;color:#aeaeb2;">设置结束时间</label>
        <input type="checkbox" id="useEnd">
      </div>

      <div class="row" id="endRow" style="display:none;">
        <label>结束时间</label>
        <div class="inputs">
          <input type="number" id="endH" min="0" max="9" value="2">
          <span class="sep">:</span>
          <input type="number" id="endM" min="0" max="59" value="50">
          <span class="sep">:</span>
          <input type="number" id="endS" min="0" max="59" value="0">
        </div>
      </div>

      <button class="apply-btn" id="applyBtn">应用并开始</button>
      <button class="close-btn" id="closeBtn">关闭</button>
    </div>
  </div>

</div>

<script>
  let startMs = (3*3600 + 50*60) * 1000;
  let endMs = null;
  let speed = 3;
  let startTime = null;
  let rafId = null;

  function format(ms) {
    let totalCs = Math.floor(ms / 10);
    let cs = totalCs % 100;
    let totalSec = Math.floor(totalCs / 100);
    let s = totalSec % 60;
    let totalMin = Math.floor(totalSec / 60);
    let m = totalMin % 60;
    let h = Math.floor(totalMin / 60);
    return h + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0') + '.' + String(cs).padStart(2,'0');
  }

  function tick(now) {
    if (startTime === null) startTime = now;
    const elapsed = (now - startTime) * speed;
    let current = startMs + elapsed;
    if (endMs !== null && current >= endMs) current = endMs;
    const text = format(current);
    document.getElementById('timer').textContent = text;
    document.getElementById('lap').textContent = text;
    if (endMs === null || current < endMs) {
      rafId = requestAnimationFrame(tick);
    } else {
      document.getElementById('startbtn').textContent = 'Start';
    }
  }

  function startAnimation() {
    if (rafId) cancelAnimationFrame(rafId);
    startTime = null;
    document.getElementById('timer').textContent = format(startMs);
    document.getElementById('lap').textContent = format(startMs);
    document.getElementById('startbtn').textContent = 'Stop';
    rafId = requestAnimationFrame(tick);
  }

  // Settings panel wiring
  const panelBackdrop = document.getElementById('panelBackdrop');
  const closeBtn = document.getElementById('closeBtn');
  const applyBtn = document.getElementById('applyBtn');
  const useEndCheckbox = document.getElementById('useEnd');
  const endRow = document.getElementById('endRow');

  closeBtn.addEventListener('click', () => panelBackdrop.classList.remove('open'));
  panelBackdrop.addEventListener('click', (e) => {
    if (e.target === panelBackdrop) panelBackdrop.classList.remove('open');
  });
  useEndCheckbox.addEventListener('change', () => {
    endRow.style.display = useEndCheckbox.checked ? 'flex' : 'none';
  });

  applyBtn.addEventListener('click', () => {
    const sh = parseInt(document.getElementById('startH').value) || 0;
    const sm = parseInt(document.getElementById('startM').value) || 0;
    const ss = parseInt(document.getElementById('startS').value) || 0;
    startMs = (sh*3600 + sm*60 + ss) * 1000;

    speed = parseFloat(document.getElementById('speedInput').value) || 1;

    if (useEndCheckbox.checked) {
      const eh = parseInt(document.getElementById('endH').value) || 0;
      const em = parseInt(document.getElementById('endM').value) || 0;
      const es = parseInt(document.getElementById('endS').value) || 0;
      endMs = (eh*3600 + em*60 + es) * 1000;
    } else {
      endMs = null;
    }

    panelBackdrop.classList.remove('open');
    startAnimation();
  });

  document.getElementById('resetBtn').addEventListener('click', startAnimation);

  // initial run
  startAnimation();
</script>
</body>
</html>
